{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "checkJs": false,
    "baseUrl": ".."
  },
  "include": [
    "../next-env.d.ts",
    "../**/*.ts",
    "../**/*.tsx",
    "../.next/types/**/*.ts",
    "../.next/dev/types/**/*.ts",
    "../*.ts",
    "../*.tsx",
    "../*.js",
    "../*.jsx",
    "../*.mjs",
    "../*.cjs"
  ],
  "exclude": [
    "../node_modules"
  ]
}
